            e.stopPropagation();
            const popup = document.getElementById("pekora-obc-stack-popup");
            const title = document.getElementById("pekora-obc-stack-popup-title");
            const list = document.getElementById("pekora-obc-stack-popup-list");
            title.textContent = uaidBtn._pekoraName;
            list.innerHTML = "";
            uaidBtn._pekoraEntries.forEach(entry => {
              const entryRow = document.createElement("div");
              entryRow.style.cssText = "padding:3px 0;border-bottom:1px solid rgba(255,255,255,0.06);color:#e6ffed;font-size:12px";
              entryRow.textContent = entry;
              list.appendChild(entryRow);

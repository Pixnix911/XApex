    function getPekoramonsValueByName(name) {
      const v = lookupValueForNameModal(name);
      return (typeof v === "number" && v > 0) ? v : 0;
    }

    function isUaidItem(name) {
      if (!name) return false;
      const lower = name.toLowerCase();
      if (lower.includes("uaid")) return true;
      const m = name.match(/\b(\d{6,})\b/);
      if (m && !name.includes("#")) return true;
      return false;
    }

    function extractSerial(name) {
      if (!name) return Infinity;
      const patterns = [/#\s*(\d+)/, /serial[:\s#]*(\d+)/i, /s\/n[:\s]*(\d+)/i];
      for (const pat of patterns) {
        const m = name.match(pat);
        if (m) return parseInt(m[1], 10);
      }
      const parenM = name.match(/\((\d+)\)\s*$/) || name.match(/\[(\d+)\]\s*$/);
      if (parenM) return parseInt(parenM[1], 10);
      const tokens = (name.match(/\b(\d+)\b/g) || []).map(Number).filter(n =>
        n > 0 && n < 100000 && !(n >= 1900 && n <= 2100)
      );
      if (tokens.length) return Math.min(...tokens);
      return Infinity;

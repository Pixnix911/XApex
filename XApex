          valueEl.innerHTML = `${PEKORAMONS_SVG}<span>Value: ${val.toLocaleString()}</span>`;
          card.dataset.value = val;
          card.dataset.rap = rap;
          card.dataset.name = cardName;
          card.dataset.serial = isUaidItem(cardName) ? "uaid" : String(extractSerial(cardName));
        } catch (e) { dbg("collectible card inject error", e); }

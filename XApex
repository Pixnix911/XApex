      try {
        const items = (await fetchAllCollectibles(userId)).sort((a, b) => (b.recentAveragePrice || 0) - (a.recentAveragePrice || 0));
        const totalRap = items.reduce((s, i) => s + (i.recentAveragePrice || 0), 0);
        const rapEl = body.querySelector(".col-12.col-lg-3 p.fw-bolder");
        if (rapEl) rapEl.textContent = `Total RAP: ${totalRap.toLocaleString()}`;

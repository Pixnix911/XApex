      const rapDiff = (receive.rap || 0) - (give.rap || 0);
      const valueDiff = (receive.total || 0) - (give.total || 0);
      const rapPct = give.rap > 0 ? (rapDiff / give.rap) * 100 : (rapDiff === 0 ? 0 : (rapDiff > 0 ? 100 : -100));
      const valuePct = give.total > 0 ? (valueDiff / give.total) * 100 : (valueDiff === 0 ? 0 : (valueDiff > 0 ? 100 : -100));
      let pillRow = dividerRow.parentElement.querySelector(".pekora-legacy-diff-pills");
      if (!pillRow) {
        pillRow = document.createElement("div");
        pillRow.className = "pekora-legacy-diff-pills";
        pillRow.style.cssText = "display:flex;justify-content:center;gap:10px;padding:6px 0;width:100%;";
        dividerRow.insertAdjacentElement("afterend", pillRow);
      }
      pillRow.innerHTML = pekoraLegacyMakePill("RAP", rapDiff, rapPct) + pekoraLegacyMakePill("Value", valueDiff, valuePct);
    }

    function pekoraLegacyEnsureModalHeight() {
      const modalWrapper = document.querySelector('[class*="modalWrapper-0-2-"]');
      const innerSection = document.querySelector('[class*="innerSection-0-2-"]');
      if (!modalWrapper || !innerSection || modalWrapper.dataset.pekoraHeightBumped) return;
      modalWrapper.dataset.pekoraHeightBumped = "1";
      const EXTRA = 50;
      const curH = parseFloat(modalWrapper.style.height) || modalWrapper.offsetHeight;
      modalWrapper.style.height = (curH + EXTRA) + "px";
      const curInnerH = parseFloat(innerSection.style.height) || innerSection.offsetHeight;
      innerSection.style.height = (curInnerH + EXTRA) + "px";
      const m = (modalWrapper.style.marginTop || "").match(/calc\((-?[\d.]+)px\s*\+\s*50vh\)/);
      if (m) {
        const base = parseFloat(m[1]);
        modalWrapper.style.marginTop = `calc(${base - EXTRA / 2}px + 50vh)`;
      }
      const acceptBtn = document.querySelector('[class*="acceptButton-0-2-"]');
      const buttonRow = acceptBtn ? acceptBtn.closest(".row") : null;
      if (buttonRow) {
        const curMt = parseFloat(getComputedStyle(buttonRow).marginTop) || 0;
        buttonRow.style.marginTop = (curMt + 12) + "px";
      }
    }

    function runLegacyTradeInjector() {
      const giveHeading = [...document.querySelectorAll("p")].find(
        (el) => el.children.length === 0 && /ITEMS YOU WILL GIVE/i.test(el.textContent || "")
      );
      if (!giveHeading) return;
      pekoraLegacyEnsureModalHeight();
      const headingRow = giveHeading.closest(".row");
      const container = headingRow ? headingRow.parentElement : null;
      if (!container) return;
      let mode = null;
      const sides = { give: null, receive: null };
      let dividerRow = null;
      Array.from(container.children).forEach((row) => {
        const text = row.textContent || "";
        if (/ITEMS YOU WILL GIVE/i.test(text) && row.querySelector('[class*="valueLabel-0-2-"]')) {
          mode = "give";
          sides.give = { labelEl: row.querySelector('[class*="valueLabel-0-2-"]'), total: 0, sawAny: false, rap: 0 };
        } else if (/ITEMS YOU WILL RECEIVE/i.test(text) && row.querySelector('[class*="valueLabel-0-2-"]')) {
          mode = "receive";
          sides.receive = { labelEl: row.querySelector('[class*="valueLabel-0-2-"]'), total: 0, sawAny: false, rap: 0 };
        } else if (row.querySelector(".divider-top")) {
          dividerRow = row;
          const dividerLine = row.querySelector(".col-12.divider-top.mb-2");
          if (dividerLine) dividerLine.style.setProperty("display", "none", "important");
        } else if (mode && row.querySelector('[class*="itemName-0-2-"]')) {
          pekoraLegacyProcessItemRow(row, sides[mode]);
        }
      });
      if (sides.give) pekoraLegacyFlushSection(sides.give.labelEl, sides.give);
      if (sides.receive) pekoraLegacyFlushSection(sides.receive.labelEl, sides.receive);
      if (sides.give && sides.receive && dividerRow) {
        pekoraLegacyInsertDiffPills(dividerRow, sides.give, sides.receive);
      }
    }

    (async function () {
      await loadKoromons();
      setInterval(runLegacyTradeInjector, 300);
    })();

  })();

  /* ---------------------------
     Catalog Item Page
     Adds the pekoramons.lol value under the "Best Price" block.
     1. Tries /api/items/search?q=   (lenient, also returns value)
     2. Falls back to /api/items/name/:itemName  (exact)
     If both miss → shows "Value: N/A" in grey (small) and stops retrying.
  --------------------------- */
  (function () {
    "use strict";

    const CATALOG_SVG = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1094 1466.2" style="width:16px;height:16px;flex-shrink:0;vertical-align:middle;"><path fill="#0084dd" d="M1094 521.6 0 0v469.5l141-67.4 250 119.2L0 707.8v369.7l815.6 388.7L315 893l779-371.4z"></path></svg>`;
    const CATALOG_SVG_GREY = CATALOG_SVG.replace('#0084dd', '#7a7a7a');

    const _catalogResolved = new Set();

    function getCatalogItemName() {
      const h1 = document.querySelector("h1");
      if (h1) {
        const t = (h1.textContent || "").replace(/[\u200B-\u200F\uFEFF]/g, "").replace(/\s+/g, " ").trim();
        if (t) return t;
      }
      const parts = location.pathname.split('/').filter(Boolean);
      const lastPart = parts[parts.length - 1] || "";
      const noHash = lastPart.split('#')[0];
      let name = noHash;
      try { name = decodeURIComponent(noHash); } catch (e) {}
      return name.replace(/-/g, ' ').replace(/\s+/g, ' ').trim();
    }

    // Same layout for all three states — always icon + text, so the row
    // keeps its shape. The N/A variant keeps the icon (grey) and matches
    // the blue value's size, just muted.
    function renderCatalogValue(valueEl, state, value) {
      if (state === "loading") {
        valueEl.innerHTML = `${CATALOG_SVG}<span style="color:#00b3ff;font-weight:700;font-size:14px;">Value: ...</span>`;
      } else if (state === "ok") {
        valueEl.innerHTML = `${CATALOG_SVG}<span style="color:#00b3ff;font-weight:700;font-size:14px;">Value: ${Number(value).toLocaleString()}</span>`;
      } else {
        valueEl.innerHTML = `${CATALOG_SVG_GREY}<span style="color:#7a7a7a;font-weight:700;font-size:13px;line-height:1.2;">Value: N/A</span>`;
      }
    }

    async function trySearchEndpoint(name) {
      try {
        const data = await pekoraFetchPekoramonsJson(
          ITEM_SEARCH_PATH + "?q=" + encodeURIComponent(name)
        );
        if (!data) return null;
        const n = Number(data.Value !== undefined ? data.Value : data.value);
        if (isFinite(n) && n > 0) return { value: n, canon: data.Name || data.name || null };
      } catch (e) { warn("search endpoint failed for", name, "→", e.message || e); }
      return null;
    }

    async function tryNameEndpoint(name) {
      try {
        const data = await pekoraFetchPekoramonsJson(
          ITEM_VALUE_PATH_PREFIX + encodeURIComponent(name)
        );
        if (!data) return null;
        const n = Number(data.Value !== undefined ? data.Value : data.value);
        if (isFinite(n) && n > 0) return { value: n, canon: data.Name || data.name || null };
      } catch (e) { warn("name endpoint failed for", name, "→", e.message || e); }
      return null;
    }

    async function resolveCatalogValue(itemName) {
      const key = cleanNameForLookup(itemName);
      if (!key) return null;
      if (NAME_VALUE_MAP.has(key)) {
        const v = NAME_VALUE_MAP.get(key);
        if (isFinite(v) && v > 0) return v;
      }
      let hit = await trySearchEndpoint(itemName);
      if (!hit) hit = await tryNameEndpoint(itemName);
      if (!hit) {
        const stripped = itemName.replace(/\(.*?\)|\[.*?\]|\{.*?\}/g, "").trim();
        if (stripped && stripped !== itemName) hit = await trySearchEndpoint(stripped);
      }
      if (hit) {
        NAME_VALUE_MAP.set(key, hit.value);
        if (hit.canon) NAME_VALUE_MAP.set(cleanNameForLookup(hit.canon), hit.value);
        return hit.value;
      }
      return null;
    }

    async function refreshCatalogValue(valueEl, itemName) {
      const key = cleanNameForLookup(itemName);
      const cached = NAME_VALUE_MAP.get(key);
      if (isFinite(cached) && cached > 0) {
        renderCatalogValue(valueEl, "ok", cached);
        return;
      }
      if (_catalogResolved.has(key)) {
        renderCatalogValue(valueEl, "n/a");
        return;
      }
      if (valueEl._pekoraLoading) return;
      valueEl._pekoraLoading = true;
      renderCatalogValue(valueEl, "loading");
      try {
        const val = await resolveCatalogValue(itemName);
        _catalogResolved.add(key);
        if (!valueEl.isConnected) return;
        if (isFinite(val) && val > 0) renderCatalogValue(valueEl, "ok", val);
        else renderCatalogValue(valueEl, "n/a");
      } finally {
        valueEl._pekoraLoading = false;
      }
    }

    // Locate the price column (block that holds the price + subtitle, but
    // NOT the Buy button). Walk up from the price number until the parent
    // would start containing Buy; the last element is the price column.
    function findPriceColumn() {
      const allEls = [...document.querySelectorAll('*')];

      const bestPriceEl = allEls.find(el =>
        el.children.length === 0 && /^Best Price$/i.test((el.textContent || "").trim())
      );
      if (!bestPriceEl) return null;

      const buyBtn = allEls.find(el => {
        if (el.tagName !== "BUTTON" && el.tagName !== "A") return false;
        const t = (el.textContent || "").trim();
        return /^Buy$/i.test(t);
      });

      const startIdx = allEls.indexOf(bestPriceEl);
      let priceNumEl = null;
      for (let i = startIdx + 1; i < Math.min(startIdx + 120, allEls.length); i++) {
        const el = allEls[i];
        if (el.children.length !== 0) continue;
        const t = (el.textContent || "").trim();
        if (t.length >= 2 && /^[\d,]+$/.test(t)) { priceNumEl = el; break; }
      }
      if (!priceNumEl) return null;

      let el = priceNumEl;
      while (el.parentElement) {
        if (buyBtn && el.parentElement.contains(buyBtn)) break;
        el = el.parentElement;
      }
      return el;
    }

    function runCatalogInjector() {
      if (!/^\/catalog\//i.test(location.pathname)) return;
      const itemName = getCatalogItemName();
      if (!itemName) return;

      const column = findPriceColumn();
      if (!column) return;

      let valueEl = column.querySelector(":scope > .pekora-catalog-value");
      if (!valueEl) valueEl = document.querySelector(".pekora-catalog-value");

      const stillInRightPlace = valueEl && valueEl.isConnected && valueEl.parentElement === column;
      if (stillInRightPlace) {
        refreshCatalogValue(valueEl, itemName);
        return;
      }

      if (valueEl && valueEl.isConnected) valueEl.remove();

      valueEl = document.createElement("div");
      valueEl.className = "pekora-catalog-value";
      valueEl.style.cssText = [
        "display:flex",
        "align-items:center",
        "justify-content:flex-start",
        "gap:4px",
        "margin-top:6px",
        "line-height:1.2",
        "white-space:nowrap",
      ].join(";");

      // Force the column to stack vertically so our line drops below the
      // price / subtitle instead of being laid inline.
      try {
        const cs = getComputedStyle(column);
        if (cs.display === "flex" && cs.flexDirection !== "column") {
          column.style.setProperty("flex-direction", "column", "important");
          column.style.setProperty("align-items", "flex-start", "important");
        }
      } catch (e) {}

      column.appendChild(valueEl);

      dbg("catalog: resolving value for", JSON.stringify(itemName));
      refreshCatalogValue(valueEl, itemName);
    }

    (async function () {
      await loadKoromons();
      runCatalogInjector();
      setInterval(runCatalogInjector, 300);
    })();

  })();

})();

// ==UserScript==
// @name         XApex
// @namespace    XA
// @version      1.0
// @description  Pekora Trading extension
// @author       fluouliss
// @match        https://pekora.pro/*
// @match        https://www.pekora.pro/*
// @grant        GM_xmlhttpRequest
// @connect      raw.githubusercontent.com
// @connect      pekoramons.lol
// @connect      www.pekoramons.lol
// @connect      pekora.pro
// @connect      www.pekora.pro
// @run-at       document-idle
// @icon         https://pekora.pro/favicon.ico
// ==/UserScript==

(function () {
  "use strict";

  const PEKORA_DEBUG = false;
  function dbg(...a) { if (PEKORA_DEBUG) console.log("[pekora]", ...a); }
  function warn(...a) { console.warn("[pekora]", ...a); }

  const PEKORAMONS_HOSTS = ["https://pekoramons.lol", "https://www.pekoramons.lol"];
  const FALLBACK_VALUES_JSON_URL = "https://raw.githubusercontent.com/unitedbygrief/koronevalues/main/valu.json";
  const ITEM_VALUE_PATH_PREFIX = "/api/items/name/";
  const ITEM_SEARCH_PATH = "/api/items/search";
  const CATALOG_ITEMS_PATH = "/api/items";

  let ITEMS = [];
  const NAME_VALUE_MAP = new Map();
  const _pekoraValueInFlight = new Map();
  const _pekoraValueMisses = new Set();
  const _pekoraValueFailCount = new Map();
  let NAME_ID_MAP = new Map();
  let NAME_ACRONYM_MAP = new Map();
  let FETCHED = false;

  function pekoraFetchOneJson(url) {
    return new Promise((resolve, reject) => {
      const headers = {
        Accept: "application/json",
        "User-Agent": navigator.userAgent,
        Referer: location.origin + "/",
      };
      if (typeof GM_xmlhttpRequest !== "function") {
        fetch(url, { credentials: "include" })
          .then(r => {
            if (!r.ok) return r.text().then(t => Promise.reject(new Error("HTTP " + r.status + ": " + t.slice(0, 120))));
            return r.json();
          })
          .then(json => { dbg("OK", url, "→", JSON.stringify(json).slice(0, 200)); resolve(json); })
          .catch(err => { warn("fail", url, err.message || err); reject(err); });
        return;
      }
      GM_xmlhttpRequest({
        method: "GET",
        url,
        headers,
        timeout: 8000,
        onload(res) {
          if (res.status >= 400) {
            warn("fail", url, "HTTP", res.status, (res.responseText || "").slice(0, 120));
            reject(new Error("HTTP " + res.status));
            return;
          }
          try {
            const json = JSON.parse(res.responseText);
            dbg("OK", url, "→", JSON.stringify(json).slice(0, 200));
            resolve(json);
          } catch (e) {
            warn("bad JSON from", url, (res.responseText || "").slice(0, 160));
            reject(new Error("bad JSON"));
          }
        },
        onerror(err) { warn("network error", url, err); reject(err); },
        ontimeout() { warn("timeout", url); reject(new Error("timeout")); },
      });
    });
  }

  function pekoraFetchPekoramonsJson(path) {
    const candidates = [];
    if (/^https?:\/\//i.test(path)) {
      candidates.push(path);
    } else {
      candidates.push(location.origin + path);
      for (const h of PEKORAMONS_HOSTS) candidates.push(h + path);
    }
    return (async () => {
      let lastErr;
      for (const url of candidates) {
        try { return await pekoraFetchOneJson(url); }
        catch (e) { lastErr = e; }
      }
      throw lastErr || new Error("all fetch attempts failed");
    })();
  }

  function fetchValuesJson(url) {
    return new Promise((resolve, reject) => {
      try {
        GM_xmlhttpRequest({
          method: "GET",
          url,
          headers: { Accept: "application/json" },
          onload(res) {
            try {
              const parsed = JSON.parse(res.responseText);
              if (!Array.isArray(parsed) || parsed.length === 0) {
                reject(new Error(`Empty or invalid values JSON from ${url}`));
                return;
              }
              resolve(parsed);
            } catch (e) { reject(e); }
          },
          onerror(err) { reject(err); }
        });
      } catch (e) { reject(e); }
    });
  }

  let _loadKoromonsPromise = null;

  async function loadKoromons() {
    if (FETCHED) return _loadKoromonsPromise;
    FETCHED = true;
    _loadKoromonsPromise = (async () => {
      try {
        ITEMS = await pekoraFetchPekoramonsJson(CATALOG_ITEMS_PATH);
        dbg("loaded catalog", ITEMS.length, "items");
      } catch (e) {
        warn("catalog fetch failed, falling back to GitHub", e);
        try {
          ITEMS = await fetchValuesJson(FALLBACK_VALUES_JSON_URL);
        } catch (e2) {
          warn("fallback catalog fetch failed", e2);
          ITEMS = [];
        }
      }
      buildNameValueMap();
      return { ITEMS, NAME_VALUE_MAP };
    })();
    return _loadKoromonsPromise;
  }

  function cleanNameForLookup(name) {
    if (!name || typeof name !== "string") return "";
    return name.replace(/[\u200B-\u200F\uFEFF]/g, "")
      .replace(/[^a-zA-Z0-9 ]/g, " ")
      .replace(/\s+/g, " ")
      .trim()
      .toLowerCase();
  }

  function pekoraEnsureItemValue(rawName) {
    const name = (rawName == null ? "" : String(rawName)).trim();
    if (!name) return Promise.resolve();
    const key = cleanNameForLookup(name);
    if (!key) return Promise.resolve();
    if (NAME_VALUE_MAP.has(key) || _pekoraValueMisses.has(key)) return Promise.resolve();
    if (_pekoraValueInFlight.has(key)) return _pekoraValueInFlight.get(key);

    const p = (async () => {
      try {
        const data = await pekoraFetchPekoramonsJson(
          ITEM_VALUE_PATH_PREFIX + encodeURIComponent(name)
        );
        const v = Number(data && (data.Value !== undefined ? data.Value : data.value));
        if (isFinite(v) && v > 0) {
          NAME_VALUE_MAP.set(key, v);
          _pekoraValueFailCount.delete(key);
        } else {
          _pekoraValueMisses.add(key);
        }
      } catch (e) {
        const n = (_pekoraValueFailCount.get(key) || 0) + 1;
        _pekoraValueFailCount.set(key, n);
        if (n >= 5) _pekoraValueMisses.add(key);
      } finally {
        _pekoraValueInFlight.delete(key);
      }
    })();

    _pekoraValueInFlight.set(key, p);
    return p;
  }

  async function awaitValueForName(rawName) {
    const name = (rawName == null ? "" : String(rawName)).trim();
    if (!name) return undefined;
    const cached = lookupValueForNameModal(name);
    if (typeof cached === "number") return cached;
    const stripped = name.replace(/\(.*?\)|\[.*?\]|\{.*?\}/g, "").trim();
    await Promise.all([
      pekoraEnsureItemValue(name),
      (stripped && stripped !== name) ? pekoraEnsureItemValue(stripped) : Promise.resolve(),
    ]);
    return lookupValueForNameModal(name);
  }

  const _pekoraSearchResolveCache = new Map();
  function pekoraResolveQueryToName(query) {
    const q = (query || "").trim();
    if (!q) return Promise.resolve(null);
    const key = q.toLowerCase();
    if (_pekoraSearchResolveCache.has(key)) return _pekoraSearchResolveCache.get(key);
    const p = (async () => {
      try {
        const data = await pekoraFetchPekoramonsJson(ITEM_SEARCH_PATH + "?q=" + encodeURIComponent(q));
        if (!data) return null;
        const name = data.Name || data.name;
        return name ? String(name) : null;
      } catch (e) { _pekoraSearchResolveCache.delete(key); return null; }
    })();
    _pekoraSearchResolveCache.set(key, p);
    return p;
  }

  function pekoraPrimeSearchCache(query) {
    const q = (query || "").trim();
    if (!q) return;
    pekoraResolveQueryToName(q).then((name) => { if (name) pekoraEnsureItemValue(name); });
  }

  function buildNameValueMap() {
    NAME_ID_MAP = new Map();
    NAME_ACRONYM_MAP = new Map();
    if (!Array.isArray(ITEMS)) return;
    for (const it of ITEMS) {
      const n = (it.Name || it.name || it.title || "").toString();
      if (!n) continue;
      const key = cleanNameForLookup(n);
      const id = it.itemId || it.ItemId || it.id;
      if (id) NAME_ID_MAP.set(key, id);
      const acr = (it.Acronym || it.acronym || "").toString().trim().toLowerCase();
      if (acr && acr !== "n/a" && acr !== "") NAME_ACRONYM_MAP.set(acr, key);
    }
  }

  function lookupIdForName(rawName) {
    if (!rawName) return null;
    const cleaned = cleanNameForLookup(rawName.trim());
    if (NAME_ID_MAP.has(cleaned)) return NAME_ID_MAP.get(cleaned);
    const stripped = rawName.trim().replace(/\(.*?\)|\[.*?\]|\{.*?\}/g, "").trim();
    return NAME_ID_MAP.get(cleanNameForLookup(stripped)) || null;
  }

  function lookupValueForNameModal(rawName) {
    if (!rawName) return undefined;
    const name = String(rawName).trim();
    const cleaned = cleanNameForLookup(name);
    const stripped = name.replace(/\(.*?\)|\[.*?\]|\{.*?\}/g, "").trim();
    const cleanedStripped = cleanNameForLookup(stripped);
    pekoraEnsureItemValue(name);
    if (cleanedStripped && cleanedStripped !== cleaned) pekoraEnsureItemValue(stripped);
    if (NAME_VALUE_MAP.has(cleaned)) return NAME_VALUE_MAP.get(cleaned);
    if (cleanedStripped && NAME_VALUE_MAP.has(cleanedStripped)) return NAME_VALUE_MAP.get(cleanedStripped);
    for (const [k, v] of NAME_VALUE_MAP.entries()) {
      if (!k) continue;
      if (k === cleaned) return v;
      if (k.length > 3 && cleaned.includes(k)) return v;
      if (cleaned.length > 3 && k.includes(cleaned)) return v;
      const kWords = k.split(" ").slice(0, 2).join(" ");
      if (kWords && cleaned.includes(kWords)) return v;
    }
    return undefined;
  }

  function formatNumber(n) {
    if (n === null || n === undefined || !isFinite(Number(n))) return "N/A";
    return Number(n).toLocaleString();
  }

  const PEKORA_FILLER_WORDS = new Set(["of", "the", "a", "an", "and"]);

  function pekoraItemMatches(rawName, query) {
    const q = (query || "").trim().toLowerCase();
    if (!q) return true;
    if (!rawName) return false;
    const nameLower = String(rawName).toLowerCase();
    if (nameLower.includes(q)) return true;
    const cleaned = cleanNameForLookup(rawName);
    if (cleaned.includes(q)) return true;
    if (NAME_ACRONYM_MAP.has(q) && NAME_ACRONYM_MAP.get(q) === cleaned) return true;
    for (const [acr, nameKey] of NAME_ACRONYM_MAP.entries()) {
      if (acr.startsWith(q) && nameKey === cleaned) return true;
    }
    const words = cleaned.split(" ").filter(Boolean);
    if (words.length > 1) {
      const initials = words.map(w => w[0]).join("");
      if (initials === q || initials.startsWith(q)) return true;
      const sigInitials = words.filter(w => !PEKORA_FILLER_WORDS.has(w)).map(w => w[0]).join("");
      if (sigInitials.length > 1 && (sigInitials === q || sigInitials.startsWith(q))) return true;
    }
    return false;
  }
    const INLINE_ROBUX_SVG = `<svg xmlns="http://www.w3.org/2000/svg" version="1.1" id="branded" x="0px" y="0px" width="24" height="24" viewBox="0 0 24 24" xml:space="preserve">
  <style>.st0{fill:#02B757;}.st3{fill:#02B757;}</style>
  <g transform="translate(-2,-114)"><g>
    <path class="st3" d="m 14,138 c -6.6,0 -12,-5.4 -12,-12 0,-6.6 5.4,-12 12,-12 6.6,0 12,5.4 12,12 0,6.6 -5.4,12 -12,12 z m 0,-22 c -5.5,0 -10,4.5 -10,10 0,5.5 4.5,10 10,10 5.5,0 10,-4.5 10,-10 0,-5.5 -4.5,-10 -10,-10 z"/>
    <path class="st3" d="m 19,131 h -5 c -0.2,0 -0.4,-0.1 -0.6,-0.2 L 9,127.3 v 2.7 c 0,0.6 -0.4,1 -1,1 -0.6,0 -1,-0.4 -1,-1 v -8 c 0,-0.6 0.4,-1 1,-1 h 4 c 1.1,0 1.7,1.1 1.7,3 0,0.6 -0.1,1.2 -0.2,1.7 -0.4,1.2 -1.2,1.3 -1.5,1.3 h -0.1 l 2.5,2 H 19 c 0.3,0 0.5,-0.5 0.5,-1 0,-0.4 -0.1,-1 -0.5,-1 h -2 c -1.4,0 -2.5,-1.3 -2.5,-3 0,-0.7 0.2,-1.4 0.5,-1.9 0.5,-0.7 1.2,-1.1 2,-1.1 h 3 c 0.6,0 1,0.4 1,1 0,0.6 -0.4,1 -1,1 h -3 c -0.1,0 -0.2,0 -0.3,0.2 -0.1,0.2 -0.2,0.5 -0.2,0.8 0,0.4 0.2,1 0.5,1 h 2 c 1.4,0 2.5,1.3 2.5,3 0,1.7 -1.1,3 -2.5,3 z M 9,125 h 2.6 c 0.1,-0.5 0.1,-1.5 0,-2 H 9 Z"/>
  </g></g></svg>`;

    function pekoraFindInventoryController(node) {
      const fiberKey = Object.keys(node).find((k) => k.startsWith("__reactFiber$"));
      if (!fiberKey) return null;
      let fiber = node[fiberKey];
      while (fiber) {
        const props = fiber.memoizedProps;
        if (props && typeof props.onToggleItem === "function" && Array.isArray(props.items)) {
          return props;
        }
        fiber = fiber.return;
      }
      return null;
    }

    function pekoraAddItemDirect(grid, item) {
      if (!grid || !grid.isConnected) {
        warn("pekoraAddItemDirect: grid is missing/detached", grid);
        return false;
      }
      const controllerProps = pekoraFindInventoryController(grid);
      if (!controllerProps) {
        warn("pekoraAddItemDirect: couldn't find onToggleItem on the fiber tree above", grid);
        return false;
      }
      try {
        controllerProps.onToggleItem(item);
        return true;
      } catch (e) {
        warn("pekoraAddItemDirect: onToggleItem threw", e);
        return false;
      }
    }

    const _pekoraClassCache = {};
    function pekoraFindClassByPrefix(prefix) {
      if (_pekoraClassCache[prefix]) return _pekoraClassCache[prefix];
      const re = new RegExp(`\\.(${prefix}[\\w-]*)`);
      for (const sheet of document.styleSheets) {
        let rules;
        try { rules = sheet.cssRules; } catch (e) { continue; }
        if (!rules) continue;
        for (const rule of rules) {
          if (!rule.selectorText) continue;
          const m = rule.selectorText.match(re);
          if (m) { _pekoraClassCache[prefix] = m[1]; return m[1]; }
        }
      }
      return null;
    }

    function pekoraToggleSelectedLook(btn, isSelected) {
      const thumb = btn.querySelector('[class*="itemThumb"]');
      if (!thumb) return;
      const selClass = pekoraFindClassByPrefix("itemThumbSelected");
      const checkClass = pekoraFindClassByPrefix("selectedCheck");
      if (selClass) thumb.classList.toggle(selClass, isSelected);
      if (checkClass) {
        let check = thumb.querySelector(`.${CSS.escape(checkClass)}`);
        if (isSelected) {
          if (!check) {
            check = document.createElement("span");
            check.className = checkClass;
            check.textContent = "✓";
            thumb.appendChild(check);
          }
        } else if (check) { check.remove(); }
      }
    }

  loadKoromons();

  (function () {
    "use strict";

    (function injectTradeCSS() {
      const obcContainers = [
        'tradeList-0-2-', 'tradeRow-0-2-', 'itemCard', 'itemButton',
        'itemGrid', 'itemThumb', 'details-0-2-', 'section-0-2-',
        'offerPanel', 'builderColumn', 'inventorySection'
      ];
      const notControls = ':not(button):not(button *):not(select):not(select *):not(input):not(input *):not(a):not(a *):not(svg):not(svg *):not(path)';
      const obcTextRule = obcContainers
        .map(c => `html.pekora-obc-active [class*="${c}"] *${notControls}`)
        .join(',\n') + ' { color: #ffffff !important; }';

      const css = `
[class*="valueCurrencyLabel"],[class*="priceLabel"],[class*="totalCurrencyLabel"]{color:rgb(150,150,150) !important;}
[class*="itemName-0-2-184"]{display:-webkit-box !important;-webkit-line-clamp:2 !important;-webkit-box-orient:vertical !important;overflow:hidden !important;text-overflow:ellipsis !important;}
[class*="itemButton"]{display:flex !important;flex-direction:column !important;justify-content:flex-start !important;}
[class*="itemButton"].pekora-search-hidden{display:none !important;}
[class*="itemValue-0-2-185"]{margin-top:2px !important;}
[class*="rowDate"]{position:absolute !important;top:4px !important;right:4px !important;font-size:10px !important;}
html.pekora-obc-active [class*="title-0-2-"] { color: #ffffff !important; }
${obcTextRule}
      `;
      const st = document.createElement("style");
      st.textContent = css;
      document.head.appendChild(st);
    })();

    function pekoraGetThemeColors() {
      let isDarkPack = false;
      try {
        isDarkPack = /obc/i.test(getComputedStyle(document.body).backgroundImage || "");
      } catch (e) {}
      try {
        document.documentElement.classList.toggle("pekora-obc-active", isDarkPack);
      } catch (e) {}

      let isLight = null;
      if (!isDarkPack) {
        try {
          const probe = document.createElement("div");
          probe.style.cssText = "position:absolute;width:0;height:0;overflow:hidden;pointer-events:none;";
          probe.style.color = "var(--white-color)";
          document.body.appendChild(probe);
          const resolved = getComputedStyle(probe).color;
          probe.remove();
          const m = resolved.match(/(\d+)\D+(\d+)\D+(\d+)/);
          if (m) {
            const [r, g, b] = [Number(m[1]), Number(m[2]), Number(m[3])];
            isLight = (0.299 * r + 0.587 * g + 0.114 * b) / 255 > 0.6;
          }
        } catch (e) {}
        if (isLight === null) {
          isLight = !!(window.matchMedia && window.matchMedia("(prefers-color-scheme: light)").matches);
        }
      } else { isLight = false; }

      if (isDarkPack) {
        return {
          isLight: false, ink: "#ffffff", inkFaint: "rgba(255,255,255,0.3)",
          pillBg: "rgb(45,47,48)", surfaceBg: "rgb(57,57,57)", surfaceBorder: "rgba(255,255,255,0.15)",
        };
      }
      return isLight
        ? { isLight: true, ink: "#1a1a1a", inkFaint: "rgba(0,0,0,0.3)",
            pillBg: "rgb(105,108,113)", surfaceBg: "var(--white-color)", surfaceBorder: "var(--text-color-secondary)" }
        : { isLight: false, ink: "#ffffff", inkFaint: "rgba(255,255,255,0.3)",
            pillBg: "rgb(45,47,48)", surfaceBg: "var(--white-color)", surfaceBorder: "var(--text-color-secondary)" };
    }

    let tradePartnerMap = {};
    let tradeListIds = [];
    let tradeDiffCache = {};
    let loggedInUserId = null;
    let _pekoraSearchActive = false;
    let _pekoraSearchState = {};

    fetch("/apisite/users/v1/users/authenticated", { credentials: "include" })
      .then(r => r.json()).then(d => { if (d && d.id) loggedInUserId = d.id; })
      .catch(() => {});

    fetch("/api/auth/me", { credentials: "include" })
      .then(r => r.json()).then(d => { if (d && d.id && !loggedInUserId) loggedInUserId = d.id; })
      .catch(() => {});

    async function computeTradeOffers(data) {
      if (!data || !data.offers || data.offers.length < 2) return null;
      let myOffer, partnerOffer;
      if (loggedInUserId) {
        myOffer = data.offers.find(o => o.user && o.user.id === loggedInUserId);
        partnerOffer = data.offers.find(o => o.user && o.user.id !== loggedInUserId);
      } else {
        const partnerId = data.user && data.user.id;
        partnerOffer = data.offers.find(o => o.user && o.user.id === partnerId);
        myOffer = data.offers.find(o => o.user && o.user.id !== partnerId);
        if (myOffer && myOffer.user) loggedInUserId = myOffer.user.id;
      }
      if (!partnerOffer || !myOffer) return null;

      const sumOffer = async (offer) => {
        let val = 0;
        for (const a of (offer.userAssets || [])) {
          const r = a.recentAveragePrice || 0;
          const v = await awaitValueForName(a.name);
          val += (typeof v === "number" && v > 0) ? v : r;
        }
        return val;
      };
      const [giveVal, recvVal] = await Promise.all([sumOffer(myOffer), sumOffer(partnerOffer)]);
      return { giveVal, recvVal };
    }

    async function fetchTradeDiff(tradeId) {
      if (tradeDiffCache[tradeId] && tradeDiffCache[tradeId].fetched) return;
      tradeDiffCache[tradeId] = { fetched: true };
      try {
        const resp = await fetch(`/apisite/trades/v1/trades/${tradeId}`, { credentials: "include" });
        const data = await resp.json();
        if (data.offers) {
          for (const o of data.offers) if (o.user) tradePartnerMap[o.user.name.toLowerCase()] = o.user.id;
        }
        const diff = await computeTradeOffers(data);
        if (diff) tradeDiffCache[tradeId] = { ...diff, fetched: true };
      } catch(e) {}
    }

    async function loadTradeList() {
      if (!/^\/trades/i.test(location.pathname)) return;
      try {
        const resp = await fetch("/apisite/trades/v1/trades/inbound?cursor=", { credentials: "include" });
        const data = await resp.json();
        if (data && data.data) {
          tradeListIds = data.data.map(t => t.id);
          tradeDiffCache = {};
          for (const t of data.data) fetchTradeDiff(t.id);
        }
      } catch(e) {}
    }
    (function waitForValues() {
      if (FETCHED) { loadTradeList(); }
      else { setTimeout(waitForValues, 300); }
    })();

    (function interceptTradeXHR() {
      const OrigXHR = unsafeWindow.XMLHttpRequest;
      function PatchedXHR() {
        const xhr = new OrigXHR();
        const origOpen = xhr.open.bind(xhr);
        let _url = "";
        xhr.open = function(method, url, ...rest) { _url = url; return origOpen(method, url, ...rest); };
        xhr.addEventListener("load", function() {
          try {
            if (/\/apisite\/trades\/v1\/trades\/(inbound|outbound|completed|inactive)/.test(_url)) {
              const data = JSON.parse(xhr.responseText);
              if (data && data.data) {
                tradeListIds = data.data.map(t => t.id);
                for (const t of data.data) fetchTradeDiff(t.id);
                const typeMatch = _url.match(/\/trades\/(inbound|outbound|completed|inactive)/);
                const type = typeMatch && typeMatch[1];
                if (type && type !== "inbound") {
                  if (pekoraLoadMore.type !== type) pekoraLoadMoreReset();
                  pekoraLoadMore.type = type;
                  pekoraLoadMore.cursor = data.nextPageCursor || null;
                }
              }
              return;
            }
            if (/\/apisite\/trades\/v1\/trades\/\d+/.test(_url)) {
              const data = JSON.parse(xhr.responseText);
              if (data.offers) {
                for (const o of data.offers) if (o.user) tradePartnerMap[o.user.name.toLowerCase()] = o.user.id;
                computeTradeOffers(data).then(diff => {
                  if (diff) tradeDiffCache[data.id] = { ...diff, fetched: true };
                }).catch(() => {});
              }
            }
          } catch(e) {}
        });
        return xhr;
      }
      PatchedXHR.prototype = OrigXHR.prototype;
      unsafeWindow.XMLHttpRequest = PatchedXHR;
    })();

    const pekoraLoadMore = { type: null, cursor: null, loading: false, initialised: false };
    let pekoraCurrentDetail = null;
    let pekoraCurrentListItem = null;

    function pekoraLoadMoreReset() {
      pekoraLoadMore.type = null; pekoraLoadMore.cursor = null;
      pekoraLoadMore.loading = false; pekoraLoadMore.initialised = false;
      document.getElementById("pekora-lm-wrap")?.remove();
      document.querySelectorAll("[data-pekora-lm-row]").forEach(el => el.remove());
    }

    function pekoraGetRowCls() {
      const row = document.querySelector('[class*="tradeRow-0-2-"]');
      if (!row) return null;
      const pick = (prefix) => {
        const el = row.querySelector(`[class*="${prefix}"]`);
        return el ? (el.className.split(" ").find(c => c.includes(prefix)) || "") : "";
      };
      return {
        row: row.className.split(" ").find(c => c.includes("tradeRow-0-2-") && !c.includes("Selected")) || "",
        avatarFrame: pick("avatarFrame"),
        rowName: pick("rowName"),
        rowStatus: pick("rowStatus"),
        rowDate: pick("rowDate"),
      };
    }

    function pekoraRenderNativeRow(listItem, detail, cls, avatarUrl) {
      const partner = listItem.user || {};
      const date = listItem.created
        ? new Date(listItem.created).toLocaleDateString("en-US", { month: "numeric", day: "numeric", year: "2-digit" })
        : "";
      const btn = document.createElement("button");
      btn.type = "button";
      btn.className = cls.row;
      btn.style.cssText = "position:relative;width:100%;overflow:hidden;";
      const avatarSpan = document.createElement("span");
      avatarSpan.className = cls.avatarFrame;
      const img = document.createElement("img");
      img.alt = partner.name || "";
      img.style.cssText = "width:100%;height:100%;object-fit:cover;";
      img.onerror = () => { img.style.display = "none"; };
      if (avatarUrl) img.src = avatarUrl;
      avatarSpan.appendChild(img);
      btn.appendChild(avatarSpan);
      const infoSpan = document.createElement("span");
      infoSpan.innerHTML =
        `<span class="${cls.rowName}">${partner.name || "Unknown"}</span>` +
        `<span class="${cls.rowStatus}">${listItem.status || ""}</span>`;
      btn.appendChild(infoSpan);
      const dateSpan = document.createElement("span");
      dateSpan.className = cls.rowDate;
      dateSpan.textContent = date;
      btn.appendChild(dateSpan);

      if (detail && detail.offers && detail.offers.length >= 2) {
        let myOffer = detail.offers.find(o => o.user && o.user.id === loggedInUserId);
        let theirOffer = detail.offers.find(o => o.user && o.user.id !== loggedInUserId);
        if (!myOffer || !theirOffer) [myOffer, theirOffer] = detail.offers;
        const sum = (assets) => (assets || []).reduce((s, a) => {
          const v = lookupValueForNameModal(a.name);
          return s + ((typeof v === "number" && v > 0) ? v : (a.recentAveragePrice || 0));
        }, 0);
        const giveVal = sum(myOffer.userAssets) + (myOffer.robux || 0);
        const recvVal = sum(theirOffer.userAssets) + (theirOffer.robux || 0);
        const barColor = recvVal >= giveVal ? "#2bbf5a" : "#d72020";
        const fmt = n => Math.round(n).toLocaleString();
        const theme = pekoraGetThemeColors();
        const pill = document.createElement("div");
        pill.className = "pekora-row-pill";
        pill.style.cssText = "position:absolute;right:0;bottom:4px;width:78px;height:50px;overflow:hidden;pointer-events:none;";
        pill.innerHTML =
          `<div style="margin-top:2%;height:90%;width:15px;float:left;background-color:${barColor};border-top-left-radius:7px;border-bottom-left-radius:7px;"></div>` +
          `<div style="float:left;padding-left:4px;font-size:11px;font-weight:700;color:${theme.ink};line-height:1.3;">` +
            `<span>${fmt(giveVal)}</span><br><hr style="margin:2px 0;border-color:${theme.inkFaint};"><span>${fmt(recvVal)}</span>` +
          `</div>`;
        btn.appendChild(pill);
        btn.onclick = (e) => { e.stopPropagation(); pekoraLoadDetailIntoPanel(detail, listItem); };
      }
      return btn;
    }

    function pekoraGetDetailCls() {
      const get = (prefix) => {
        const el = document.querySelector(`[class*="${prefix}-0-2-"]`);
        return el ? el.className.split(" ").find(c => c.includes(`${prefix}-0-2-`)) || "" : `${prefix}-0-2-0`;
      };
      return {
        section: get("section"), sectionTitle: get("sectionTitle"),
        itemGrid: get("itemGrid"), itemCard: get("itemCard"),
        thumbWrap: get("thumbWrap"), itemThumb: get("itemThumb"),
        limitedBadge: get("limitedBadge"), itemName: get("itemName"),
        itemValue: get("itemValue"), valueCurrency: get("valueCurrency"),
        valueCurrencyLabel: get("valueCurrencyLabel"), totalCurrencyLabel: get("totalCurrencyLabel"),
        totalRow: get("totalRow"), totalValue: get("totalValue"),
      };
    }

    async function pekoraLoadDetailIntoPanel(detail, listItem) {
      const panel = document.querySelector('[class*="details-0-2-"]');
      if (!panel) return;
      const c = pekoraGetDetailCls();
      const partnerId = listItem.user && listItem.user.id;
      let theirOffer = detail.offers.find(o => o.user && o.user.id === partnerId);
      let myOffer = detail.offers.find(o => o.user && o.user.id !== partnerId);
      if (!myOffer || !theirOffer) [myOffer, theirOffer] = detail.offers;
      const partnerName = (theirOffer.user && theirOffer.user.name) || "Unknown";

      const allAssets = [...(myOffer.userAssets || []), ...(theirOffer.userAssets || [])];
      const assetIds = allAssets.map(a => a.assetId).filter(Boolean);
      const thumbMap = {};
      if (assetIds.length) {
        try {
          const td = await fetch(`/apisite/thumbnails/v1/assets?assetIds=${assetIds.join(",")}&size=150x150&format=Png`, { credentials: "include" }).then(r => r.json());
          (td.data || []).forEach(t => { thumbMap[t.targetId] = t.imageUrl; });
        } catch(e) {}
      }

      const renderItems = (assets) => (assets || []).map(a => {
        const thumb = thumbMap[a.assetId] || "";
        const badge = a.serialNumber ? `<span class="${c.limitedBadge}">#${a.serialNumber}</span>` : "";
        const rap = a.recentAveragePrice || 0;
        return `<div class="${c.itemCard}">
          <div class="${c.thumbWrap}">
            <div class="${c.itemThumb}"><img src="${thumb}" alt="${a.name}" onerror="this.style.visibility='hidden'"></div>
            ${badge}
          </div>
          <div class="${c.itemName}">${a.name}</div>
          <div class="${c.itemValue}">
            <div class="${c.valueCurrency}">
              <span class="pekora-robux-icon" style="display:inline-flex;align-items:center;width:16px;height:16px;margin-right:3px;">${INLINE_ROBUX_SVG.replace('width="24" height="24"', 'width="16" height="16"')}</span>
              <span class="${c.valueCurrencyLabel || "valueCurrencyLabel-0-2-0"}">${rap.toLocaleString()}</span>
            </div>
          </div>
        </div>`;
      }).join("");

      const renderSection = (title, offer) => {
        const rapTotal = (offer.userAssets || []).reduce((s, a) => s + (a.recentAveragePrice || 0), 0);
        const lblCls = c.totalCurrencyLabel || c.valueCurrencyLabel || "valueCurrencyLabel-0-2-0";
        return `
        <section class="${c.section}">
          <h2 class="${c.sectionTitle}">${title}</h2>
          <div class="${c.itemGrid}">${renderItems(offer.userAssets)}</div>
          <div class="${c.totalRow}">
            <span>Total Value:</span>
            <span class="${c.totalValue}">
              <div class="${c.valueCurrency}">
                <span class="pekora-robux-icon" style="display:inline-flex;align-items:center;width:21px;height:21px;margin-right:4px;">${INLINE_ROBUX_SVG.replace('width="24" height="24"', 'width="21" height="21"')}</span>
                <span class="${lblCls}">${rapTotal.toLocaleString()}</span>
              </div>
            </span>
          </div>
        </section>`;
      };

      Array.from(panel.children)
        .filter(c => c.id !== "pekora-detail-overlay")
        .forEach(c => { c.dataset.pekoraHidden = "1"; c.style.visibility = "hidden"; });

      let overlay = document.getElementById("pekora-detail-overlay");
      if (!overlay) {
        overlay = document.createElement("div");
        overlay.id = "pekora-detail-overlay";
        if (window.getComputedStyle(panel).position === "static") panel.style.position = "relative";
        overlay.style.cssText = "position:absolute;inset:0;z-index:10;overflow-y:auto;";
        panel.appendChild(overlay);
      }
      overlay.innerHTML =
        `<h1 class="detailTitle-0-2-17">Trade with ${partnerName}</h1>` +
        renderSection("Items you will give", myOffer) +
        renderSection("Items you will receive", theirOffer);

      pekoraCurrentDetail = detail;
      pekoraCurrentListItem = listItem;
    }

    async function pekoraDoLoadMore() {
      if (pekoraLoadMore.loading || !pekoraLoadMore.type) return;
      pekoraLoadMore.loading = true;
      const btn = document.getElementById("pekora-lm-btn");
      if (btn) { btn.textContent = "Loading..."; btn.disabled = true; }
      try {
        const url = `/apisite/trades/v1/trades/${pekoraLoadMore.type}?limit=25&cursor=${encodeURIComponent(pekoraLoadMore.cursor || "")}`;
        const data = await fetch(url, { credentials: "include" }).then(r => r.json());
        if (!data || !data.data) return;
        pekoraLoadMore.cursor = data.nextPageCursor || null;
        const cls = pekoraGetRowCls();
        const tradeList = document.querySelector('[class*="tradeList-0-2-"]');
        if (cls && tradeList) {
          const details = await Promise.all(
            data.data.map(t => fetch(`/apisite/trades/v1/trades/${t.id}`, { credentials: "include" }).then(r => r.json()).catch(() => null))
          );
          const partnerIds = data.data.map(t => t.user && t.user.id).filter(Boolean);
          const avatarMap = {};
          if (partnerIds.length) {
            try {
              const thumbData = await fetch(
                `/apisite/thumbnails/v1/users/avatar-headshot?userIds=${partnerIds.join(",")}&size=150x150&format=Png&isCircular=false`,
                { credentials: "include" }
              ).then(r => r.json());
              (thumbData.data || []).forEach(entry => { avatarMap[entry.targetId] = entry.imageUrl; });
            } catch(e) {}
          }
          data.data.forEach((t, i) => {
            const avatarUrl = t.user ? (avatarMap[t.user.id] || "") : "";
            const row = pekoraRenderNativeRow(t, details[i], cls, avatarUrl);
            row.dataset.pekoraLmRow = "1";
            tradeList.appendChild(row);
          });
        }
        if (btn) {
          if (pekoraLoadMore.cursor) { btn.textContent = "Load More"; btn.disabled = false; }
          else { btn.parentElement.remove(); }
        }
      } catch(e) {
        if (btn) { btn.textContent = "Load More"; btn.disabled = false; }
      } finally { pekoraLoadMore.loading = false; }
    }

    async function pekoraEnsureLoadMoreSection() {
      if (!/^\/trades/i.test(location.pathname)) return;
      const sel = document.querySelector('[class*="select-0-2-"]');
      if (!sel) return;
      const type = sel.value;
      if (!type || type === "inbound") { pekoraLoadMoreReset(); return; }
      if (pekoraLoadMore.type && pekoraLoadMore.type !== type) pekoraLoadMoreReset();
      const tradeList = document.querySelector('[class*="tradeList-0-2-"]');
      if (!tradeList) return;
      if (!pekoraLoadMore.initialised) {
        pekoraLoadMore.initialised = true;
        pekoraLoadMore.type = type;
        try {
          const data = await fetch(`/apisite/trades/v1/trades/${type}?limit=25&cursor=`, { credentials: "include" }).then(r => r.json());
          pekoraLoadMore.cursor = (data && data.nextPageCursor) || null;
        } catch(e) { pekoraLoadMore.cursor = null; }
      }
      if (!document.getElementById("pekora-lm-btn")) {
        if (!pekoraLoadMore.cursor) return;
        const cls = pekoraGetRowCls();
        if (!cls) return;
        const btnWrap = document.createElement("div");
        btnWrap.id = "pekora-lm-wrap";
        btnWrap.style.cssText = "display:flex;justify-content:center;padding:8px 0;";
        const selectEl = document.querySelector('[class*="select-0-2-"]');
        const btn = document.createElement("button");
        btn.id = "pekora-lm-btn";
        btn.type = "button";
        btn.textContent = "Load More";
        if (selectEl) {
          const s = window.getComputedStyle(selectEl);
          btn.style.cssText = `height:${s.height};padding:${s.padding};font-size:${s.fontSize};font-family:${s.fontFamily};font-weight:${s.fontWeight};background:${s.background};border:${s.border};border-radius:${s.borderRadius};cursor:pointer;min-width:120px;`;
          btn.style.color = "inherit";
        } else {
          btn.style.cssText = "height:32px;padding:0 12px;font-size:14px;border-radius:4px;cursor:pointer;min-width:120px;";
        }
        btn.onclick = pekoraDoLoadMore;
        btnWrap.appendChild(btn);
        tradeList.insertAdjacentElement("afterend", btnWrap);
      }
    }

    const makePill = (label, diff, pct) => {
      const isGain = diff >= 0;
      const arrowColor = isGain ? "rgb(43, 191, 90)" : "rgb(215, 32, 32)";
      const sign = diff >= 0 ? "+" : "-";
      const verb = isGain ? "winning" : "losing";
      const arrowPath = isGain
        ? `<path fill="currentColor" d="M9 4h6v8h4.84L12 19.84L4.16 12H9V4Z"></path>`
        : `<path fill="currentColor" d="M15 20H9v-8H4.16L12 4.16L19.84 12H15v8Z"></path>`;
      const tooltip = `You are ${verb} ${Math.abs(diff).toLocaleString()} ${label.toLowerCase()} on this trade.`;
      const pillBg = pekoraGetThemeColors().pillBg;
      return `<div data-toggle="tooltip" title="" style="height:30px;background-color:${pillBg} !important;color:#ffffff !important;align-items:center;padding:5px 12px;cursor:default;flex-grow:0;flex-shrink:0;width:fit-content;display:flex;justify-content:center;font-size:20px;white-space:nowrap;" data-original-title="${tooltip}"><span style="display:flex;align-items:center;color:#ffffff !important;"><svg xmlns="http://www.w3.org/2000/svg" style="transform:scale(1.3);margin-right:3px;color:${arrowColor} !important;" width="24" height="24" viewBox="0 0 24 24"><g transform="translate(0 24) scale(1 -1)">${arrowPath}</g></svg><span style="color:#ffffff !important;">${sign}${Math.abs(diff).toLocaleString()} ${label} (${sign}${Math.abs(pct).toFixed(0)}%)</span></span></div>`;
    };

    function runTradesPageInjector() {
      if (!/^\/trades/i.test(location.pathname) && !/^\/users\/\d+\/trade/i.test(location.pathname)) return;
      pekoraEnsureLoadMoreSection().catch(() => {});
      if (pekoraCurrentDetail && pekoraCurrentListItem && !document.getElementById("pekora-detail-overlay")) {
        pekoraLoadDetailIntoPanel(pekoraCurrentDetail, pekoraCurrentListItem).catch(() => {});
      }
      const tradeRows = Array.from(document.querySelectorAll('[class*="tradeRow-0-2-"]:not([data-pekora-lm-row])'));
      if (tradeRows.length > 0 && tradeRows.length !== tradeListIds.length) loadTradeList();
      tradeRows.forEach((row, i) => {
        if (!row._pekoraNativeClickBound) {
          row._pekoraNativeClickBound = true;
          row.addEventListener("click", () => {
            pekoraCurrentDetail = null;
            pekoraCurrentListItem = null;
            const p = document.querySelector('[class*="details-0-2-"]');
            if (p) {
              document.getElementById("pekora-detail-overlay")?.remove();
              p.querySelectorAll("[data-pekora-hidden]").forEach(c => {
                c.style.visibility = "";
                delete c.dataset.pekoraHidden;
              });
            }
          });
        }
        const tradeId = tradeListIds[i];
        if (!tradeId) return;
        const diff = tradeDiffCache[tradeId];
        if (!diff || diff.giveVal === undefined) return;
        const overallColor = diff.recvVal >= diff.giveVal ? "#2bbf5a" : "#d72020";
        let box = row.querySelector(".pekora-row-pill");
        if (!box) {
          row.style.position = "relative";
          box = document.createElement("div");
          box.className = "pekora-row-pill";
          box.style.cssText = "position:absolute;right:0;bottom:4px;width:78px;height:50px;overflow:hidden;pointer-events:none;";
          row.appendChild(box);
        }
        const fmt = (n) => Math.round(n).toLocaleString();
        const theme = pekoraGetThemeColors();
        box.innerHTML =
          `<div style="margin-top:2%;margin-left:0;height:90%;width:15px;float:left;background-color:${overallColor};border-top-left-radius:7px;border-bottom-left-radius:7px;"></div>` +
          `<div style="float:left;padding-left:4px;font-size:11px;font-weight:700;color:${theme.ink};line-height:1.3;">` +
            `<span>${fmt(diff.giveVal)}</span><br>` +
            `<hr style="margin:2px 0;border-color:${theme.inkFaint};">` +
            `<span>${fmt(diff.recvVal)}</span>` +
          `</div>`;
      });

      const titleEl = document.querySelector('[class*="detailTitle"]');
      if (titleEl) {
        const rawText = Array.from(titleEl.childNodes).filter(n => n.nodeType === 3).map(n => n.textContent).join("").trim();
        const match = rawText.match(/Trade with (.+)/i);
        if (match) {
          const partnerName = match[1].trim();
          const partnerId = tradePartnerMap[partnerName.toLowerCase()];
          if (partnerId) {
            const expectedHref = `https://pekoramons.lol/player?id=${partnerId}`;
            let linkEl = titleEl.querySelector(".pekora-title-link");
            if (!linkEl) {
              linkEl = document.createElement("a");
              linkEl.className = "pekora-title-link";
              linkEl.target = "_blank";
              linkEl.rel = "noopener noreferrer";
              linkEl.style.cssText = "display:inline-flex;align-items:center;margin-left:8px;opacity:0.8;vertical-align:middle;";
              linkEl.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" height="21px" viewBox="0 -960 960 960" width="21px" fill="${pekoraGetThemeColors().ink}"><path d="M200-120q-33 0-56.5-23.5T120-200v-560q0-33 23.5-56.5T200-840h280v80H200v560h560v-280h80v280q0 33-23.5 56.5T760-120H200Zm188-212-56-56 372-372H560v-80h280v280h-80v-144L388-332Z"/></svg>`;
              titleEl.appendChild(linkEl);
            }
            if (linkEl.href !== expectedHref) linkEl.href = expectedHref;
          }
        }
      }

      const searchBarTheme = pekoraGetThemeColors();
      document.querySelectorAll('[class*="inventorySection"]').forEach((section, sIdx) => {
        if (section.querySelector('.pekora-trade-search')) return;
        const header = section.querySelector('[class*="inventoryHeader"]');
        if (!header) return;
        const grid = section.querySelector('[class*="itemGrid"]');
        if (!grid) return;
        if (sIdx === 0 && !loggedInUserId) return;
        const pagination = section.querySelector('[class*="pagination"]');
        const savedState = _pekoraSearchState[sIdx] || {};

        const wrap = document.createElement("div");
        wrap.style.cssText = "display:flex;gap:8px;align-items:center;margin-bottom:12px;";
        const input = document.createElement("input");
        input.className = "pekora-trade-search";
        input.type = "text";
        input.placeholder = "Loading items...";
        input.autocomplete = "off";
        input.style.cssText = `color:${searchBarTheme.ink};width:180px;border:1px solid ${searchBarTheme.surfaceBorder};height:34px;outline:0;padding:0 12px;font-size:15px;background:${searchBarTheme.surfaceBg};font-weight:500;border-radius:0;`;
        const sortSelect = document.createElement("select");
        sortSelect.className = "pekora-trade-sort";
        sortSelect.style.cssText = `color:${searchBarTheme.ink};border:1px solid ${searchBarTheme.surfaceBorder};height:34px;outline:0;padding:0 8px;font-size:15px;background:${searchBarTheme.surfaceBg};font-weight:500;border-radius:0;cursor:pointer;`;
        sortSelect.innerHTML = '<option value="default">Sort: Default</option><option value="value-desc">Value ↓</option><option value="value-asc">Value ↑</option><option value="name-asc">A → Z</option><option value="name-desc">Z → A</option>';
        input.value = savedState.query || "";
        sortSelect.value = savedState.sort || "default";
        wrap.appendChild(input);
        wrap.appendChild(sortSelect);
        header.insertAdjacentElement("afterend", wrap);

        const searchGrid = document.createElement("div");
        searchGrid.className = grid.className;
        searchGrid.style.display = "none";
        grid.insertAdjacentElement("afterend", searchGrid);

        const searchPag = document.createElement("div");
        searchPag.className = pagination ? pagination.className : "";
        searchPag.style.cssText = "gap:8px;display:none;font-size:18px;margin-top:16px;align-items:center;font-weight:400;justify-content:center;";
        const spPrev = document.createElement("button");
        spPrev.type = "button"; spPrev.textContent = "\u2039";
        spPrev.className = pagination ? (pagination.querySelector("button") || {}).className || "" : "";
        spPrev.style.cssText = `color:${searchBarTheme.ink};width:34px;border:1px solid ${searchBarTheme.surfaceBorder};height:34px;padding:0;font-size:26px;background:color-mix(in srgb, ${searchBarTheme.ink} 10%, ${searchBarTheme.surfaceBg});line-height:28px;border-radius:6px;cursor:pointer;`;
        const spLabel = document.createElement("span");
        const spNext = document.createElement("button");
        spNext.type = "button"; spNext.textContent = "\u203A";
        spNext.style.cssText = spPrev.style.cssText;
        searchPag.appendChild(spPrev); searchPag.appendChild(spLabel); searchPag.appendChild(spNext);
        searchGrid.insertAdjacentElement("afterend", searchPag);

        let allItems = savedState.allItems || null;
        let searchPage = 0;
        let currentMatches = [];
        const PAGE_SIZE = 10;
        const selectedIds = new Set();
        let searchRefreshTimer = null;

        function getSectionUserId() {
          if (sIdx === 0) return loggedInUserId;
          const m = location.pathname.match(/\/users\/(\d+)\/trade/);
          return m ? Number(m[1]) : null;
        }

        if (allItems) {
          input.placeholder = `Search ${allItems.length} items...`;
          if (savedState.wasOpen) showSearch(input.value.trim());
        } else {
          (async function() {
            const userId = getSectionUserId();
            if (!userId) { input.placeholder = "Search items..."; return; }
            const items = [];
            let cursor = "";
            while (true) {
              const url = `/apisite/inventory/v1/users/${userId}/assets/collectibles?limit=100${cursor ? "&cursor=" + encodeURIComponent(cursor) : ""}`;
              try {
                const res = await fetch(url, { credentials: "include" });
                if (!res.ok) break;
                const data = await res.json();
                if (data.data) items.push(...data.data);
                if (data.nextPageCursor) cursor = data.nextPageCursor;
                else break;
              } catch(e) { break; }
            }
            allItems = items;
            _pekoraSearchState[sIdx] = Object.assign(_pekoraSearchState[sIdx] || {}, { allItems: items });
            input.placeholder = `Search ${items.length} items...`;
            if (savedState.wasOpen) showSearch(input.value.trim());
          })();
        }

        function renderPage() {
          searchGrid.innerHTML = "";
          const start = searchPage * PAGE_SIZE;
          const page = currentMatches.slice(start, start + PAGE_SIZE);
          const nativeThumb = grid.querySelector('[class*="itemThumb"]');
          const thumbClass = nativeThumb ? nativeThumb.className.split(" ")[0] : "";
          for (const item of page) {
            const id = item.assetId || item.userAssetId || "";
            const name = item.name || "";
            const rap = item.recentAveragePrice || 0;
            const serial = item.serialNumber;
            const val = lookupValueForNameModal(name);
            const displayVal = (typeof val === "number" && val > 0) ? val : rap;

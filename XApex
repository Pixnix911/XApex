      function sortGrid(type, asc) {
        const cards = [...row.querySelectorAll(".col-6.col-md-4.col-lg-2.mb-2")];
        cards.sort((a, b) => {
          if (type === "name") {
            const A = (a.dataset.name || "").toLowerCase();
            const B = (b.dataset.name || "").toLowerCase();
            return asc ? A.localeCompare(B) : B.localeCompare(A);
          }
          const A = Number(a.dataset[type] || 0);
          const B = Number(b.dataset[type] || 0);
          return asc ? A - B : B - A;
        });
        cards.forEach((c) => row.appendChild(c));
      }

      function sortBySerial(asc) {
        const cards = [...row.querySelectorAll(".col-6.col-md-4.col-lg-2.mb-2")];
        function cardRawText(card) { return (card.textContent || "").replace(/\s+/g, " ").trim(); }
        function serialFromCard(card) {
          const raw = cardRawText(card);
          const hashM = raw.match(/#\s*(\d+)/);
          if (hashM) return parseInt(hashM[1], 10);
          const labelM = raw.match(/(?:serial|s\/n)[:\s#]*(\d+)/i);
          if (labelM) return parseInt(labelM[1], 10);
          const parenM = raw.match(/\((\d+)\)/);
          if (parenM) return parseInt(parenM[1], 10);
          const allNums = (raw.match(/\b(\d+)\b/g) || [])
            .map(Number).filter(n => n > 0 && n < 100000 && !(n >= 1900 && n <= 2100));
          if (allNums.length) return Math.min(...allNums);
          return Infinity;
        }
        function isUaidCard(card) {
          const raw = cardRawText(card);
          if (/uaid/i.test(raw)) return true;
          if (/\b\d{6,}\b/.test(raw) && !/#\s*\d/.test(raw)) return true;
          return false;
        }
        function bucket(card) {
          if (isUaidCard(card)) return 2;
          const s = serialFromCard(card);
          return isFinite(s) ? 0 : 1;
        }
        cards.sort((a, b) => {
          const bA = bucket(a); const bB = bucket(b);
          if (bA !== bB) return bA - bB;
          if (bA !== 0) return 0;
          const sA = serialFromCard(a); const sB = serialFromCard(b);
          if (sA !== sB) return asc ? sA - sB : sB - sA;
          return Number(b.dataset.value || 0) - Number(a.dataset.value || 0);
        });
        cards.forEach((c) => row.appendChild(c));
      }


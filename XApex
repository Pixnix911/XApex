          badge.textContent = `x${count}`;
          keeper.dataset.pekoraIsKeeper = "1";
          const entries = group.map(card => {
            const text = (card.textContent || "").replace(/\s+/g, " ").trim();
            const uaidM = text.match(/UAID[:\s]*([0-9]{4,})/i);
            if (uaidM) return "UAID: " + uaidM[1];
            const serialM = text.match(/#\s*([0-9]+)/);
            if (serialM) return "#" + serialM[1];
            const labelM = text.match(/Serial[:\s#]*([0-9]+)/i);
            if (labelM) return "#" + labelM[1];
            return card.dataset.name || "Unknown";
          });
          const cardBody = keeper.querySelector(".card-body") || keeper;
          let uaidBtn = keeper.querySelector(".pekora-uaid-btn");
          if (!uaidBtn) {
            uaidBtn = document.createElement("button");
            uaidBtn.className = "pekora-uaid-btn";
            uaidBtn.type = "button";
            uaidBtn.style.cssText = [
